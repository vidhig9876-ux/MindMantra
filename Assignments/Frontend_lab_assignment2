<!DOCTYPE html>
<html>

<head>
    <title>Frontend Lab Assignment 2</title>

    <style>
        body {
            font-family: Arial;
            margin: 30px;
            background-color: #f5f5f5;
        }

        h1 {
            text-align: center;
            color: darkblue;
        }

        h2 {
            color: darkred;
            border-bottom: 1px solid black;
            padding-bottom: 5px;
        }

        section {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
        }

        table {
            border-collapse: collapse;
            width: 80%;
        }

        th,
        td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }

        th {
            background-color: lightblue;
        }

        input,
        select {
            padding: 8px;
            margin: 8px 0 15px;
        }

        .form-input {
            width: 300px;
        }

        button {
            padding: 10px 20px;
            background-color: blue;
            color: white;
            border: none;
            cursor: pointer;
        }

        #message {
            color: green;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <h1>Frontend Lab Assignment 2</h1>


    <!-- QUESTION 1: MARKSHEET -->

    <section>

        <h2>1. Student Marksheet</h2>

        <table>

            <tr>
                <th>Subject</th>
                <th>Maximum Marks</th>
                <th>Marks Obtained</th>
            </tr>

            <tr>
                <td>Mathematics</td>
                <td>100</td>
                <td>85</td>
            </tr>

            <tr>
                <td>Physics</td>
                <td>100</td>
                <td>78</td>
            </tr>

            <tr>
                <td>Chemistry</td>
                <td>100</td>
                <td>82</td>
            </tr>

            <tr>
                <td>Computer Science</td>
                <td>100</td>
                <td>90</td>
            </tr>

            <tr>
                <th>Total</th>
                <th>400</th>
                <th>335</th>
            </tr>

        </table>

    </section>


    <!-- QUESTION 2: RESUME -->

    <section>

        <h2>2. Resume</h2>

        <h3>Vidhi Gupta</h3>

        <p>Email: vidhi@example.com</p>
        <p>Phone: 9876543210</p>

        <h3>Career Objective</h3>

        <p>
            To learn new technologies and build my skills in
            computer science while gaining practical experience.
        </p>

        <h3>Education</h3>

        <ul>
            <li>B.Tech in Computer Science Engineering - GLA University</li>
            <li>Class XII - John Milton Public School</li>
            <li>Class X - St. George's School</li>
        </ul>

        <h3>Skills</h3>

        <ul>
            <li>HTML</li>
            <li>CSS</li>
            <li>JavaScript</li>
            <li>Java</li>
        </ul>

        <h3>Projects</h3>

        <ul>
            <li>Student Management System</li>
            <li>Travel Recommendation Website</li>
        </ul>

        <h3>Hobbies</h3>

        <ul>
            <li>Reading</li>
            <li>Travelling</li>
            <li>Learning new technologies</li>
        </ul>

    </section>


    <!-- QUESTION 3: RESTAURANT MENU -->

    <section>

        <h2>3. Restaurant Menu</h2>

        <h3>Starters</h3>

        <ul>
            <li>Spring Rolls - ₹120</li>
            <li>Paneer Tikka - ₹180</li>
            <li>French Fries - ₹100</li>
        </ul>

        <h3>Main Course</h3>

        <ul>
            <li>Paneer Butter Masala - ₹220</li>
            <li>Dal Makhani - ₹180</li>
            <li>Veg Biryani - ₹200</li>
        </ul>

        <h3>Drinks</h3>

        <ul>
            <li>Cold Coffee - ₹100</li>
            <li>Fresh Lime Soda - ₹80</li>
            <li>Mango Shake - ₹120</li>
        </ul>

    </section>


    <!-- QUESTION 4: REGISTRATION FORM -->

    <section>

        <h2>4. Registration Form</h2>

        <form>

            <label for="name">Name:</label>
            <br>

            <input
                type="text"
                id="name"
                name="name"
                class="form-input"
            >

            <br>

            <label for="email">Email:</label>
            <br>

            <input
                type="email"
                id="email"
                name="email"
                class="form-input"
            >

            <br>

            <label for="password">Password:</label>
            <br>

            <input
                type="password"
                id="password"
                name="password"
                class="form-input"
            >

            <br>

            <p>Gender:</p>

            <input
                type="radio"
                id="male"
                name="gender"
                value="male"
            >

            <label for="male">Male</label>

            <input
                type="radio"
                id="female"
                name="gender"
                value="female"
            >

            <label for="female">Female</label>

            <p>Hobbies:</p>

            <input
                type="checkbox"
                id="reading"
                name="hobby"
            >

            <label for="reading">Reading</label>

            <br>

            <input
                type="checkbox"
                id="sports"
                name="hobby"
            >

            <label for="sports">Sports</label>

            <br><br>

            <label for="course">Course:</label>
            <br>

            <select id="course" name="course">

                <option value="cse">
                    CSE
                </option>

                <option value="ece">
                    ECE
                </option>

                <option value="it">
                    IT
                </option>

            </select>

            <br><br>

            <button type="submit">
                Register
            </button>

        </form>

    </section>


    <!-- QUESTION 5: LOGIN PAGE -->

    <section>

        <h2>5. Login Page</h2>

        <form onsubmit="login(event)">

            <label for="loginEmail">
                Email:
            </label>

            <br>

            <input
                type="email"
                id="loginEmail"
                class="form-input"
            >

            <br>

            <label for="loginPassword">
                Password:
            </label>

            <br>

            <input
                type="password"
                id="loginPassword"
                class="form-input"
            >

            <br><br>

            <button type="submit">
                Login
            </button>

            <p id="message"></p>

        </form>

    </section>


    <!-- JAVASCRIPT -->

    <script>

        function login(event) {

            event.preventDefault();

            let email =
                document.getElementById("loginEmail").value;

            let password =
                document.getElementById("loginPassword").value;

            if (email == "" || password == "") {

                document.getElementById("message").innerHTML =
                    "Please enter all details.";

            } else {

                document.getElementById("message").innerHTML =
                    "Login successful!";

            }
        }

    </script>

</body>

</html>
